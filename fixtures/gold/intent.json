{
  "version": 1,
  "description": "Gold set for the intent prompt (S1 scope): six invented requirements. Each has one clearly right visibility and only channels offered in the input. Checks are deterministic (agents/evaluate_agents.py).",
  "cases": [
    {
      "id": "public_filings",
      "input": {
        "requirement_id": "00000000-0000-4000-8000-000000000101",
        "requirement_text": "Public filings of listed companies: annual and quarterly reports.",
        "purpose": "Fundamental research",
        "note": null,
        "elements": [],
        "terms": ["filings"],
        "channels": [
          {"channel": "exchanges", "visibility": "public"},
          {"channel": "market_data_vendors", "visibility": "public"},
          {"channel": "public_websites", "visibility": "public"},
          {"channel": "internal_systems", "visibility": "private"}
        ]
      },
      "checks": [
        {"check": "equals", "path": "visibility", "value": "public"},
        {"check": "nonempty", "path": "where_to_search"},
        {"check": "in", "path": "where_to_search.*", "values": ["exchanges", "market_data_vendors", "public_websites"]},
        {"check": "nonempty", "path": "reason"}
      ]
    },
