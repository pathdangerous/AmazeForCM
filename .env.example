# Amaze for CM PoC — environment settings
# Copy to .env. Local values work now; Azure values are filled after the move to the office laptop.

# ---- Adapter selection (local defaults) ----
LLM_PROVIDER=mock                # mock | azure_openai
STORAGE_PROVIDER=local           # local | azure_blob
SCHEDULER_PROVIDER=local         # local | azure_functions
IDENTITY_PROVIDER=dev            # dev | entra_id
SECRETS_PROVIDER=env             # env | key_vault
NOTIFY_PROVIDER=inapp            # inapp | email
PIPELINE_PROVIDER=local          # local | azure_devops (phase 7.17: where generated code is committed)
EXTERNAL_AGENT_PROVIDER=none      # none | hexaware (phase 7.18: in-house data agents; hexaware is a stub, nothing is called)
EXTERNAL_AGENT_FOR=               # one Agent.name (e.g. MappingAgent) answered by the external agent; empty = none

# ---- External data agents (placeholder, phase 7.18) ----
EXTERNAL_AGENT_BASE_URL=
EXTERNAL_AGENT_API_KEY=
EXTERNAL_AGENT_TIMEOUT_SECONDS=

# ---- Local ----
# Local PostgreSQL installed on Windows (same format on the office laptop; change only the password)
DATABASE_URL=postgresql+psycopg://amaze:CHANGE_ME@localhost:5432/amaze
# Separate database for pytest; same user and password as DATABASE_URL
TEST_DATABASE_URL=postgresql+psycopg://amaze:CHANGE_ME@localhost:5432/amaze_test
# Separate database for python -m agents.evaluate_mappings (phase 5); same user; never the application's
EVAL_DATABASE_URL=postgresql+psycopg://amaze:CHANGE_ME@localhost:5432/amaze_eval
LOCAL_BLOB_ROOT=./data/blob
# Phase 7.17: the local pipeline's own git repository, one folder per feed (never this project's repository)
PIPELINE_REPO_ROOT=./data/pipeline-repo
# Custom data product (phase 3): the synthetic source catalogue, and the only hosts the HTTP
# connector may reach (comma-separated). Keep this machine only until the Azure move.
SOURCE_CATALOGUE=./fixtures/sources/catalogue.json
SOURCE_HTTP_ALLOWED_HOSTS=127.0.0.1,localhost
# A selected source that did not answer on this many UTC days in a row is released, and the requester
# can pick again (phase 3b). A whole number, at least 1.
SOURCE_DOWN_RELEASE_DAYS=3

# A glossary run (step 05) whose worker stopped answering is taken again after this many seconds; a slow
# model needs more (phase 5). A whole number, at least 1.
GLOSSARY_RUN_LEASE_SECONDS=300

# Phase 6. The longest one validation rule may run, in seconds (the DuckDB sandbox stops it), and the days after
# a go-live in which every scheduled load is reported to the data owner and operations. Whole numbers, at least 1.
RULE_TIMEOUT_SECONDS=5
HYPERCARE_DAYS=10
# Phase 7.20. The most rows one page of "click a rule" holds (a larger size is cut to it).
RULE_ROWS_MAX_SIZE=200

# Phase 7. A load a process that died left "received" for this many minutes is abandoned before the next load
# (step 12); a younger one is "load in progress". A whole number, at least 1.
LOAD_STALE_MINUTES=30

# Phase 7. A scheduled load whose trust score (100 x rows with no flag / rows) is at or above this is released;
# below it the load is held and its consumers are warned. A number from 1 to 100.
TRUST_RELEASE_THRESHOLD=90

# Phase 7.15. A rule failing on the same weekday, day of the month or provider date in at least PATTERN_MIN_LOADS loads of
# the last PATTERN_WINDOW_DAYS days is a recurring pattern. REPORT_HOUR (UTC, 0-23): the daily and monthly reports are built.
PATTERN_MIN_LOADS=3
PATTERN_WINDOW_DAYS=90
REPORT_HOUR=6

# Phase 7. true (default) registers the daily fetch-and-load job at start-up; false registers none (the glossary
# runs worker still runs). The Playwright API sets false.
DAILY_JOB_ENABLED=true

# ---- Phase 7.8: one operator, uploaded files, the onboarding workspace ----
# false: one operator may hold every role and approve every step; true: a second person decides the next step
REQUIRE_FOUR_EYES=false
# false: no value from a file reaches a model; true: at most 5 distinct non-empty values per column are sent
SEND_SAMPLE_VALUES=false
# The largest file the Upload screen takes, in MB
UPLOAD_MAX_MB=50
# Each uploaded feed's drop folder is DROPZONE_ROOT/<feed code>/; the daily job and Load now take its newest file
DROPZONE_ROOT=./data/dropzone
# A proposal at or above this confidence (and no tie) is shown pre-accepted; below it a person decides (0 to 1)
AUTO_ACCEPT_CONFIDENCE=0.85
# An onboarding job whose worker stopped answering is taken again after this many seconds
ONBOARDING_JOB_LEASE_SECONDS=300
# The most model calls one onboarding may make; a job past the cap is not run
MAX_MODEL_CALLS_PER_ONBOARDING=60

# ---- Azure OpenAI (phase 7.8: the real adapter; used when LLM_PROVIDER=azure_openai) ----
# The resource endpoint (https://<name>.cognitiveservices.azure.com or .openai.azure.com); a full URL is cut to it
AZURE_OPENAI_ENDPOINT=
# The deployment every prompt uses
AZURE_OPENAI_DEPLOYMENT=
# A lighter deployment for the intent and discovery_assistant prompts; empty means the main one
AZURE_OPENAI_DEPLOYMENT_SMALL=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_AUTH=key            # key | entra (entra needs the azure-identity package, not installed)
AZURE_OPENAI_API_KEY=            # only if AZURE_OPENAI_AUTH=key
# How long one model call may take, in seconds, before it counts as a timeout
LLM_TIMEOUT_SECONDS=60
# The longest Retry-After (seconds) waited on an HTTP 429 before retrying (at most twice); longer fails at once
LLM_RETRY_AFTER_CAP_SECONDS=20

# ---- Azure storage (placeholder) ----
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_CONTAINER=

# ---- Azure DevOps pipeline (placeholder) ----
AZURE_DEVOPS_ORG_URL=
AZURE_DEVOPS_PROJECT=
AZURE_DEVOPS_REPO=

# ---- Azure Functions scheduler (placeholder) ----
AZURE_FUNCTIONS_APP=

# ---- Microsoft Entra ID (placeholder) ----
AZURE_TENANT_ID=
AZURE_CLIENT_ID=

# ---- Azure Key Vault (placeholder) ----
AZURE_KEY_VAULT_URL=

# ---- Notifications (placeholder) ----
NOTIFY_EMAIL_FROM=
TEAMS_WEBHOOK_URL=
