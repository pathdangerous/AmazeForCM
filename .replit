modules = ["python-base-3.13", "nodejs-24"]
[userenv]

[userenv.development]
LLM_PROVIDER = "mock"
PYTHONPATH = "/home/runner/workspace/.runtime/baseline-packages:/home/runner/workspace"
AUTO_ACCEPT_CONFIDENCE = "0.85"
AZURE_CLIENT_ID = ""
AZURE_FUNCTIONS_APP = ""
AZURE_KEY_VAULT_URL = ""
AZURE_OPENAI_API_VERSION = ""
AZURE_OPENAI_AUTH = "key"
AZURE_OPENAI_DEPLOYMENT = ""
AZURE_OPENAI_DEPLOYMENT_SMALL = ""
AZURE_OPENAI_ENDPOINT = ""
AZURE_STORAGE_ACCOUNT = ""
AZURE_STORAGE_CONTAINER = ""
AZURE_TENANT_ID = ""
DAILY_JOB_ENABLED = "true"
DROPZONE_ROOT = "./data/dropzone"
GLOSSARY_RUN_LEASE_SECONDS = "300"
HYPERCARE_DAYS = "10"
IDENTITY_PROVIDER = "dev"
LLM_RETRY_AFTER_CAP_SECONDS = "20"
LLM_TIMEOUT_SECONDS = "60"
LOAD_STALE_MINUTES = "30"
LOCAL_BLOB_ROOT = "./data/blob"
MAX_MODEL_CALLS_PER_ONBOARDING = "60"
NOTIFY_EMAIL_FROM = ""
NOTIFY_PROVIDER = "inapp"
ONBOARDING_JOB_LEASE_SECONDS = "300"
REQUIRE_FOUR_EYES = "false"
RULE_TIMEOUT_SECONDS = "5"
SCHEDULER_PROVIDER = "local"
SECRETS_PROVIDER = "env"
SEND_SAMPLE_VALUES = "false"
SOURCE_CATALOGUE = "./fixtures/sources/catalogue.json"
SOURCE_DOWN_RELEASE_DAYS = "3"
SOURCE_HTTP_ALLOWED_HOSTS = "127.0.0.1,localhost"
STORAGE_PROVIDER = "local"
TRUST_RELEASE_THRESHOLD = "90"
UPLOAD_MAX_MB = "50"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Run baseline"

[[workflows.workflow]]
name = "Run baseline"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/dev.sh"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 3000
externalPort = 3000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5173
externalPort = 5173
exposeLocalhost = true

[[ports]]
localPort = 5174
externalPort = 3001
exposeLocalhost = true

[nix]
channel = "stable-25_05"
packages = ["glib", "nspr", "nss", "atk", "at-spi2-atk", "dbus", "xorg.libX11", "xorg.libXcomposite", "xorg.libXdamage", "xorg.libXext", "xorg.libXfixes", "xorg.libXrandr", "xorg.libxcb", "libxkbcommon", "alsa-lib", "at-spi2-core", "libgbm"]


